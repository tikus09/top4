# Environment variable files (an ".example" file with fake values is OK)
.env
.env.*
!.env.example
!.dev.vars.example

# Cloudflare Wrangler local state (local database copy, cache)
.wrangler/
# Generated by "wrangler types" (runs automatically before dev and build)
worker-configuration.d.ts

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
