# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# SECRETS: never commit these files.
# Local secrets for Cloudflare Workers (used from step 3 on)
.dev.vars
