---
import Base from '../layouts/Base.astro';

// Filled in by src/middleware.ts: the logged-in user, or null.
const { user } = Astro.locals;
---

<Base title="Top 4">
	<h1>Hello Top 4</h1>
	<p>Pick your four favorite LEGO sets. Coming soon.</p>

	{
		user ? (
			<p>
				Welcome back, <strong>{user.name}</strong>! See <a href="/me">your account</a>.
			</p>
		) : (
			<p>
				<a href="/signup">Create an account</a> or <a href="/login">log in</a> to get started.
			</p>
		)
	}
</Base>
