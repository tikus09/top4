{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "top4",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "top4-db",
			"database_id": "b21cb26f-d83a-4813-944a-60edab26d148",
			// Numbered .sql files created by drizzle-kit (see drizzle.config.ts)
			"migrations_dir": "migrations"
		}
	]
}